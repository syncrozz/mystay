rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Central Stays Collection - Real-time synchronization across all devices
    match /stays/{stayId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Subcollections: Agenda Items, Checklist Items, etc.
      match /agendaItems/{itemId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /checklistItems/{itemId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}

