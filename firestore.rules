rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Documents
    match /users/{userId} {
      allow read, write: if true;
    }

    // Central Stays Collection & all nested subcollections (agendaItems, checklistItems, etc.)
    match /stays/{stayId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}

